#include <stdio.h>
#include <string.h>

#define MAX_ALUNOS 100

typedef struct {
    int matricula;
    char nome[100];
    int idade;
    char curso[100];
} Aluno;

int main() {
    Aluno alunos[MAX_ALUNOS];
    int quantidade = 0;
    int opcao;

    do {
        printf("\n===== CADASTRO DE ALUNOS =====\n");
        printf("1 - Cadastrar aluno\n");
        printf("2 - Listar alunos\n");
        printf("0 - Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);
        getchar();

        switch (opcao) {
            case 1:
                if (quantidade >= MAX_ALUNOS) {
                    printf("Limite de alunos atingido!\n");
                    break;
                }

                printf("Matricula: ");
                scanf("%d", &alunos[quantidade].matricula);
                getchar();

                printf("Nome: ");
                fgets(alunos[quantidade].nome,
                      sizeof(alunos[quantidade].nome), stdin);
                alunos[quantidade].nome[
                    strcspn(alunos[quantidade].nome, "\n")
                ] = '\0';

                printf("Idade: ");
                scanf("%d", &alunos[quantidade].idade);
                getchar();

                printf("Curso: ");
                fgets(alunos[quantidade].curso,
                      sizeof(alunos[quantidade].curso), stdin);
                alunos[quantidade].curso[
                    strcspn(alunos[quantidade].curso, "\n")
                ] = '\0';

                quantidade++;

                printf("Aluno cadastrado com sucesso!\n");
                break;

            case 2:
                if (quantidade == 0) {
                    printf("Nenhum aluno cadastrado.\n");
                    break;
                }

                printf("\n===== ALUNOS CADASTRADOS =====\n");

                for (int i = 0; i < quantidade; i++) {
                    printf("\nAluno %d\n", i + 1);
                    printf("Matricula: %d\n", alunos[i].matricula);
                    printf("Nome: %s\n", alunos[i].nome);
                    printf("Idade: %d\n", alunos[i].idade);
                    printf("Curso: %s\n", alunos[i].curso);
                }
                break;

            case 0:
                printf("Encerrando...\n");
                break;

            default:
                printf("Opcão invalida!\n");
        }

    } while (opcao != 0);

    return 0;
}
